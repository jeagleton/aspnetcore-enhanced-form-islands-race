@page "/profile-no-streaming"

@* Candidate workaround 2: the same enhanced form on a page without [StreamRendering]. *@

<PageTitle>Profile</PageTitle>
<h1>Profile: enhanced form, no streaming</h1>

<ProfileForm Path="/profile-no-streaming" Enhanced="true" Saved="@(Saved is not null)" Chars="@(Chars ?? 70000)" Delay="@(Delay ?? 1)" />

@code {
    [SupplyParameterFromQuery] private string? Saved { get; set; }
    [SupplyParameterFromQuery] private int? Chars { get; set; }
    [SupplyParameterFromQuery] private int? Delay { get; set; }
}
