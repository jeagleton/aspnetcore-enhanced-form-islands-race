@page "/profile-not-enhanced"
@attribute [StreamRendering]

@* Candidate workaround 1: the same form without Enhance. *@

<PageTitle>Profile</PageTitle>
<h1>Profile: plain form, streaming page</h1>

<ProfileForm Path="/profile-not-enhanced" Enhanced="false" Saved="@(Saved is not null)" Chars="@(Chars ?? 70000)" Delay="@(Delay ?? 1)" />

@code {
    [SupplyParameterFromQuery] private string? Saved { get; set; }
    [SupplyParameterFromQuery] private int? Chars { get; set; }
    [SupplyParameterFromQuery] private int? Delay { get; set; }
}
